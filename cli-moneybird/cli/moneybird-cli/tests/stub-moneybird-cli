#!/usr/bin/env bash
# WHY: Provide deterministic Moneybird CLI responses without network access.
set -euo pipefail

STUB_LOG="${MONEYBIRD_TEST_LOG:-}"
ADMIN_ID="${MONEYBIRD_TEST_ADMINISTRATION_ID:-PILOT_ADMIN}"
RESOURCE=""
ACTION=""
RECORD_ID="stub-record"
FILE_PATH=""
DRY_RUN=0
LOGIN=0
ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    login)
      LOGIN=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --file)
      [[ $# -ge 2 ]] || exit 2
      FILE_PATH="$2"
      shift 2
      ;;
    --administration)
      [[ $# -ge 2 ]] || exit 2
      ADMIN_ID="$2"
      shift 2
      ;;
    --*)
      if [[ $# -ge 2 && "$2" != --* ]]; then
        shift 2
      else
        shift
      fi
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ $LOGIN -eq 1 ]]; then
  IFS= read -r TOKEN_INPUT || true
  [[ -n "$STUB_LOG" ]] && printf 'LOGIN %s\n' "${MONEYBIRD_CONFIG_DIR:-default}" >> "$STUB_LOG"
  [[ -n "$STUB_LOG" ]] && printf 'TOKEN %s\n' "${TOKEN_INPUT:-}" >> "$STUB_LOG"
  printf 'stub accepted token: %s\n' "${TOKEN_INPUT:-}"
  exit 0
fi

RESOURCE="${ARGS[0]:-contacts}"
ACTION="${ARGS[1]:-list}"
RECORD_ID="${ARGS[2]:-stub-record}"
case "$ACTION" in
  list|get) METHOD="GET" ;;
  create) METHOD="POST" ;;
  update) METHOD="PATCH" ;;
  delete) METHOD="DELETE" ;;
  *) METHOD="GET" ;;
esac
# WHY: A forwarded file makes the request a multipart write, so the guard's
# attachment binding can be rehearsed offline with the real route shape.
if [[ -n "$FILE_PATH" ]]; then
  METHOD="POST"
fi

if [[ "$ACTION" == "list" || "$ACTION" == "create" ]]; then
  URL="https://moneybird.com/api/v2/$ADMIN_ID/$RESOURCE.json"
else
  URL="https://moneybird.com/api/v2/$ADMIN_ID/$RESOURCE/$RECORD_ID.json"
fi

# WHY: MONEYBIRD_TEST_FAULT injects a named upstream failure so the guard's
# error paths are rehearsed offline. upstream-fail stops the call before any
# output with exit 1, and bad-dry-line prints a dry-run line the guard cannot
# parse as METHOD URL.
if [[ "${MONEYBIRD_TEST_FAULT:-}" == "upstream-fail" ]]; then
  printf 'stub fault: the upstream CLI failed\n' >&2
  exit 1
fi

if [[ $DRY_RUN -eq 1 ]]; then
  if [[ "${MONEYBIRD_TEST_FAULT:-}" == "bad-dry-line" ]]; then
    printf 'stub fault: this line is not a METHOD URL pair\n'
    exit 0
  fi
  printf '%s %s\n' "$METHOD" "$URL"
  if [[ "$METHOD" == "POST" || "$METHOD" == "PATCH" ]]; then
    if [[ -n "${MONEYBIRD_TEST_DRY_BODY:-}" ]]; then
      printf '%s\n' "$MONEYBIRD_TEST_DRY_BODY"
    else
      printf '{"%s":{}}\n' "$RESOURCE"
    fi
  fi
  if [[ -n "$FILE_PATH" ]]; then
    printf 'multipart field file=%s\n' "$FILE_PATH"
  fi
  exit 0
fi

[[ -n "$STUB_LOG" ]] && printf 'REAL %s %s\n' "$METHOD" "$URL" >> "$STUB_LOG"
if [[ -n "${MONEYBIRD_TEST_REAL_STATUS:-}" ]]; then
  printf 'stub request failure\n' >&2
  exit "$MONEYBIRD_TEST_REAL_STATUS"
fi
case "$METHOD" in
  GET)
    if [[ "$ACTION" == "get" ]]; then
      printf '{"id":"stub-record","company_name":"Secret Name","contacts":[{"id":"child-record"}]}\n'
    else
      printf '[{"id":"stub-record"}]\n'
    fi
    ;;
  POST|PATCH) printf '{"id":"stub-record"}\n' ;;
  DELETE) ;;
esac
