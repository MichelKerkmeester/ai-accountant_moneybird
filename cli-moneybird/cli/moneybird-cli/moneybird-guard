#!/usr/bin/env bash
# ───────────────────────────────────────────────────────────────
# COMPONENT: MONEYBIRD GUARD
# ───────────────────────────────────────────────────────────────
# Previews every Moneybird API call and holds writes behind a pilot-aware confirmation.
#
# Usage: moneybird-guard [--confirm-write] [--production] [--approval REF]
#          [--out FILE] [--print-body] <moneybird-cli args...>
#        moneybird-guard login-from-env [--writer]
#
# Exit Codes:
#   0 - Success
#   1 - Tool or dependency failure
#   2-9 - Guard refusals, named in the canonical table in references/cli.md
# Other codes pass through from moneybird-cli unchanged.
set -euo pipefail

# ───────────────────────────────────────────────────────────────
# 1. USAGE AND ERROR HELPERS
# ───────────────────────────────────────────────────────────────

# Print the accepted guard flags and the passthrough contract.
usage() {
  cat <<'USAGE'
Usage: moneybird-guard [--confirm-write] [--production] [--approval REF]
       [--out FILE] [--print-body] <moneybird-cli args...>
       moneybird-guard login-from-env [--writer]

Guard flags are read anywhere in the arguments. Other arguments pass to moneybird-cli.
Without --out the response body is captured and only a summary is printed.
--print-body streams the body for an operator.
USAGE
}

# Print a refusal or failure to stderr and exit with the given status.
die() {
  local status="$1"
  shift
  printf 'moneybird-guard: %s\n' "$*" >&2
  exit "$status"
}

# ───────────────────────────────────────────────────────────────
# 2. PINNED PATHS AND TEST OVERRIDES
# ───────────────────────────────────────────────────────────────

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd -P)"
  SOURCE_LINK="$(readlink "$SOURCE")"
  case "$SOURCE_LINK" in
    /*) SOURCE="$SOURCE_LINK" ;;
    *) SOURCE="$SOURCE_DIR/$SOURCE_LINK" ;;
  esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd -P)"
readonly SCRIPT_DIR
DEFAULT_ENV_DIR="$(cd -P "$SCRIPT_DIR/../../.." >/dev/null 2>&1 && pwd -P)"
readonly DEFAULT_ENV_DIR
# WHY: The guard pins its own repository root, the CLI binary and the writer configuration. The
# overrides exist for the test suite only, so an agent with a shell cannot redirect them.
GUARD_TEST=0
if [[ "${MONEYBIRD_GUARD_TEST:-}" == "1" ]]; then
  GUARD_TEST=1
fi
# Warn that an environment override only applies inside the test suite.
warn_ignored_var() {
  printf 'moneybird-guard: %s is ignored unless MONEYBIRD_GUARD_TEST=1.\n' "$1" >&2
}
if [[ $GUARD_TEST -eq 1 ]]; then
  ACCOUNTANT_ROOT_INPUT="${MONEYBIRD_ENV_DIR:-$DEFAULT_ENV_DIR}"
  CLI="${MONEYBIRD_CLI:-moneybird-cli}"
  WRITER_CONFIG_DIR="${MONEYBIRD_WRITER_CONFIG_DIR:-$HOME/.config/moneybird-cli-writer}"
  KEY_FILE_OVERRIDE="${MONEYBIRD_HMAC_KEY_FILE:-}"
else
  [[ -z "${MONEYBIRD_ENV_DIR:-}" ]] || warn_ignored_var MONEYBIRD_ENV_DIR
  [[ -z "${MONEYBIRD_CLI:-}" ]] || warn_ignored_var MONEYBIRD_CLI
  [[ -z "${MONEYBIRD_WRITER_CONFIG_DIR:-}" ]] || warn_ignored_var MONEYBIRD_WRITER_CONFIG_DIR
  [[ -z "${MONEYBIRD_HMAC_KEY_FILE:-}" ]] || warn_ignored_var MONEYBIRD_HMAC_KEY_FILE
  ACCOUNTANT_ROOT_INPUT="$DEFAULT_ENV_DIR"
  CLI="moneybird-cli"
  WRITER_CONFIG_DIR="$HOME/.config/moneybird-cli-writer"
  KEY_FILE_OVERRIDE=""
fi
case "$ACCOUNTANT_ROOT_INPUT" in /*) ;; *) ACCOUNTANT_ROOT_INPUT="$PWD/$ACCOUNTANT_ROOT_INPUT" ;; esac
ACCOUNTANT_ROOT="$ACCOUNTANT_ROOT_INPUT"
if [[ -d "$ACCOUNTANT_ROOT" ]]; then
  ACCOUNTANT_ROOT="$(cd -P "$ACCOUNTANT_ROOT" >/dev/null 2>&1 && pwd -P)"
else
  die 1 "Accountant root is not a directory."
fi
# WHY: The approval key is Operator-owned and lives under the ignored workspace.
# The path override exists for the test suite only, like the other overrides.
if [[ -n "$KEY_FILE_OVERRIDE" ]]; then
  KEY_FILE="$KEY_FILE_OVERRIDE"
else
  KEY_FILE="$ACCOUNTANT_ROOT/migration-workspace/.secrets/alias-hmac.key"
fi

# ───────────────────────────────────────────────────────────────
# 3. GUARD FLAG PARSING
# ───────────────────────────────────────────────────────────────

CONFIRM_WRITE=0
PRODUCTION=0
WRITER_LOGIN=0
OUT_ARG=""
OUT_SET=0
PRINT_BODY=0
APPROVAL_REF=""
PAYLOAD_DIGEST=""
ATTACHMENT_DIGEST=""
ATTACHMENT_PATH=""
INTENT_PAYLOAD_DIGEST=""
INTENT_ATTACHMENT_DIGEST=""
INTENT_BATCH_KEY=""
CLI_BEFORE=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --confirm-write)
      CONFIRM_WRITE=1
      shift
      ;;
    --production)
      PRODUCTION=1
      shift
      ;;
    --writer)
      WRITER_LOGIN=1
      shift
      ;;
    --approval)
      [[ $# -ge 2 && -n "$2" ]] || die 2 "--approval needs a run journal reference."
      APPROVAL_REF="$2"
      shift 2
      ;;
    --print-body)
      PRINT_BODY=1
      shift
      ;;
    --out)
      [[ $# -ge 2 ]] || die 2 "--out needs a file path."
      OUT_ARG="$2"
      OUT_SET=1
      shift 2
      ;;
    *)
      CLI_BEFORE+=("$1")
      shift
      ;;
  esac
done

# ───────────────────────────────────────────────────────────────
# 4. CREDENTIAL FILE HELPERS
# ───────────────────────────────────────────────────────────────

# Print the value of one key in an env file, tolerating CRLF, export and quotes.
read_env_value() {
  local file="$1"
  local key="$2"
  local line=""
  local value=""
  [[ -f "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    while [[ "$line" == [[:space:]]* ]]; do line="${line#?}"; done
    case "$line" in
      "$key="*) value="${line#*=}" ;;
      "export $key="*) value="${line#*=}" ;;
      *) continue ;;
    esac
    while [[ "$value" == [[:space:]]* ]]; do value="${value#?}"; done
    while [[ "$value" == *[[:space:]] ]]; do value="${value%?}"; done
    case "$value" in
      \"*\") value="${value#\"}"; value="${value%\"}" ;;
      \'*\') value="${value#\'}"; value="${value%\'}" ;;
    esac
    printf '%s' "$value"
    return 0
  done < "$file"
  return 1
}

# Print the pilot administration id.
# WHY: The pilot administration id is read from the pinned root, never from an environment an
# agent can edit.
pilot_admin_id() {
  local value=""
  if [[ $GUARD_TEST -eq 1 ]]; then
    value="${MONEYBIRD_PILOT_ADMINISTRATION_ID:-}"
  elif [[ -n "${MONEYBIRD_PILOT_ADMINISTRATION_ID:-}" ]]; then
    warn_ignored_var MONEYBIRD_PILOT_ADMINISTRATION_ID
  fi
  if [[ -z "$value" ]]; then
    value="$(read_env_value "$ACCOUNTANT_ROOT/.env" MONEYBIRD_PILOT_ADMINISTRATION_ID || true)"
  fi
  printf '%s' "$value"
}

# ───────────────────────────────────────────────────────────────
# 5. PASSTHROUGH AND DRY-RUN
# ───────────────────────────────────────────────────────────────

# Whether the command is an administration call that skips the dry-run gates.
is_passthrough() {
  if [[ "${CLI_BEFORE[0]:-}" == "administration" ]]; then
    case "${CLI_BEFORE[1]:-}" in
      list|current) return 0 ;;
      use)
        [[ -n "${CLI_BEFORE[2]:-}" ]] && return 0
        ;;
    esac
  fi
  return 1
}

# Run the passthrough command and exit with its status.
run_passthrough() {
  "$CLI" ${CLI_BEFORE[@]+"${CLI_BEFORE[@]}"} || exit "$?"
  exit 0
}

# Capture the CLI dry-run output and exit with its status when it fails.
run_dry() {
  local -a args=()
  [[ ${#CLI_BEFORE[@]} -gt 0 ]] && args+=("${CLI_BEFORE[@]}")
  args+=(--dry-run)
  local dry_status=0
  DRY_OUTPUT="$("$CLI" "${args[@]}")" || dry_status="$?"
  if [[ $dry_status -ne 0 ]]; then
    [[ -n "$DRY_OUTPUT" ]] && printf '%s\n' "$DRY_OUTPUT" >&2
    exit "$dry_status"
  fi
}

# Parse the first dry-run line into the globals METHOD, URL_PATH and ADMIN_ID.
parse_dry_line() {
  local dry_line="${DRY_OUTPUT%%$'\n'*}"
  local extra=""
  IFS=' ' read -r METHOD URL extra <<< "$dry_line"
  [[ "$METHOD" =~ ^[A-Z]+$ && "$URL" == http* ]] || return 1
  [[ -z "$extra" ]] || return 1
  URL_HOST_PATH="${URL#*://}"
  [[ "$URL_HOST_PATH" == */* ]] || return 1
  URL_PATH="/${URL_HOST_PATH#*/}"
  URL_PATH="${URL_PATH%%\?*}"
  URL_PATH="${URL_PATH%%\#*}"
  case "$URL_PATH" in
    /api/v2/*/*) ;;
    *) return 1 ;;
  esac
  local remainder="${URL_PATH#/api/v2/}"
  ADMIN_ID="${remainder%%/*}"
  [[ -n "$ADMIN_ID" ]] || return 1
  return 0
}

# ───────────────────────────────────────────────────────────────
# 6. REQUEST SHAPE CHECKS
# ───────────────────────────────────────────────────────────────

# Whether the parsed request is the read-only synchronization fetch.
# WHY: A synchronization fetch sends its id list as a POST body but only reads
# records, so it runs as a read. Only the exact resource synchronization path
# qualifies, and every other POST still meets the write gates.
is_sync_fetch() {
  [[ "$METHOD" == "POST" ]] || return 1
  [[ "$URL_PATH" =~ ^/api/v2/[^/]+/[a-z_]+/synchronization(\.json)?$ ]]
}

# Whether the CLI arguments carry an explicit period filter.
has_period_filter() {
  local i=0
  local arg=""
  while [[ $i -lt ${#CLI_BEFORE[@]} ]]; do
    arg="${CLI_BEFORE[$i]}"
    case "$arg" in
      --filter)
        if [[ $((i + 1)) -lt ${#CLI_BEFORE[@]} && "${CLI_BEFORE[$((i + 1))]}" == *period:* ]]; then
          return 0
        fi
        ;;
      --filter=*)
        [[ "$arg" == *period:* ]] && return 0
        ;;
    esac
    i=$((i + 1))
  done
  return 1
}

# Whether the CLI arguments request a list action.
is_list_action() {
  local arg=""
  for arg in ${CLI_BEFORE[@]+"${CLI_BEFORE[@]}"}; do
    [[ "$arg" == "list" ]] && return 0
  done
  return 1
}

# ───────────────────────────────────────────────────────────────
# 7. OUTPUT PATH VALIDATION
# ───────────────────────────────────────────────────────────────

# Resolve --out into the global OUT_PATH or refuse when it leaves the workspace.
validate_out_path() {
  local candidate=""
  local relative=""
  local segment=""
  local rest=""
  local cursor=""
  local depth=0
  local workspace_root="$ACCOUNTANT_ROOT/migration-workspace"
  if [[ "$OUT_ARG" == /* ]]; then
    candidate="$OUT_ARG"
    case "$OUT_ARG" in
      "$ACCOUNTANT_ROOT_INPUT"/migration-workspace/*)
        relative="${OUT_ARG#"$ACCOUNTANT_ROOT_INPUT"/migration-workspace/}"
        candidate="$workspace_root/$relative"
        ;;
    esac
  else
    candidate="$ACCOUNTANT_ROOT/$OUT_ARG"
  fi
  case "/$candidate/" in
    *"/../"*) return 1 ;;
  esac
  # WHY: A trailing slash names a folder, and a folder target would save the body
  # under a hidden temporary name instead of the requested file.
  case "$candidate" in
    */|*/.) return 1 ;;
  esac
  case "$candidate" in
    "$workspace_root"/*) ;;
    *) return 1 ;;
  esac
  relative="${candidate#"$ACCOUNTANT_ROOT"/}"
  cursor="$ACCOUNTANT_ROOT"
  rest="$relative"
  while [[ -n "$rest" ]]; do
    if [[ "$rest" == */* ]]; then
      segment="${rest%%/*}"
      rest="${rest#*/}"
    else
      segment="$rest"
      rest=""
    fi
    [[ -z "$segment" || "$segment" == "." ]] && continue
    depth=$((depth + 1))
    # WHY: The guard keeps its key, its approval journal and its write log in these
    # folders, so a saved response must never replace them. The match ignores case
    # because the default macOS file system does.
    if [[ $depth -eq 2 ]]; then
      case "$(printf '%s' "$segment" | tr '[:upper:]' '[:lower:]')" in
        .secrets|runjournal|logs) return 1 ;;
      esac
    fi
    cursor="$cursor/$segment"
    [[ -L "$cursor" ]] && return 1
    if [[ -e "$cursor" && -n "$rest" && ! -d "$cursor" ]]; then
      return 1
    fi
  done
  [[ -d "$candidate" ]] && return 1
  OUT_PATH="$candidate"
  return 0
}

# ───────────────────────────────────────────────────────────────
# 8. WRITE PREREQUISITES
# ───────────────────────────────────────────────────────────────

# Stop a write when the separate writer configuration is missing.
require_writer_config() {
  if [[ ! -d "$WRITER_CONFIG_DIR" ]]; then
    die 7 "Writer configuration is missing. A write needs the writer session and never falls back to the reader token."
  fi
}

# Print the --file argument when the CLI call carries an attachment.
attachment_path() {
  local i=0
  local arg=""
  while [[ $i -lt ${#CLI_BEFORE[@]} ]]; do
    arg="${CLI_BEFORE[$i]}"
    case "$arg" in
      --file)
        if [[ $((i + 1)) -lt ${#CLI_BEFORE[@]} ]]; then
          printf '%s' "${CLI_BEFORE[$((i + 1))]}"
        fi
        return 0
        ;;
      --file=*)
        printf '%s' "${arg#--file=}"
        return 0
        ;;
    esac
    i=$((i + 1))
  done
  return 0
}

# Exit early when python3 is missing.
# WHY: Every digest, approval and summary step runs through python3, so one test names the gap.
require_python3() {
  command -v python3 >/dev/null 2>&1 ||
    die 1 "python3 is required to compute digests, check approvals and summarise bodies."
}

# ───────────────────────────────────────────────────────────────
# 9. DIGEST AND APPROVAL BINDING
# ───────────────────────────────────────────────────────────────

# Compute the HMAC that binds an approval to this exact method, path and body.
digest_helper() {
  local method="$1"
  local url_path="$2"
  local dry_output="$3"
  if [[ ! -f "$KEY_FILE" || ! -r "$KEY_FILE" || ! -s "$KEY_FILE" ]]; then
    die 1 "The HMAC key file is missing, empty or unreadable at $KEY_FILE."
  fi
  require_python3
  PAYLOAD_DIGEST="$(python3 -I - "$KEY_FILE" "$method" "$url_path" "$dry_output" <<'PY'
import hashlib
import hmac
import sys

key_path = sys.argv[1]
method = sys.argv[2]
url_path = sys.argv[3]
dry_output = sys.argv[4]
with open(key_path, "rb") as handle:
    key = handle.read()
# WHY: This canonical form pins exactly what an approval covers, so the same
# payload always yields the same digest while a changed, reordered or
# retargeted body never does. It is the method, the URL path without query or
# fragment and every dry-run line after the first, each closed by one LF.
canonical = method + "\n" + url_path + "\n"
for line in dry_output.split("\n")[1:]:
    if line.endswith("\r"):
        line = line[:-1]
    canonical += line + "\n"
print(hmac.new(key, canonical.encode("utf-8"), hashlib.sha256).hexdigest())
PY
)" || die 1 "The payload digest could not be computed from the key file at $KEY_FILE."
}

# Compute the HMAC of the raw attachment bytes into ATTACHMENT_DIGEST.
attachment_digest_helper() {
  local file_path="$1"
  if [[ ! -f "$file_path" || ! -r "$file_path" ]]; then
    die 1 "The attachment file cannot be read at $file_path."
  fi
  ATTACHMENT_DIGEST="$(python3 -I - "$KEY_FILE" "$file_path" <<'PY'
import hashlib
import hmac
import sys

key_path = sys.argv[1]
file_path = sys.argv[2]
with open(key_path, "rb") as handle:
    key = handle.read()
with open(file_path, "rb") as handle:
    data = handle.read()
print(hmac.new(key, data, hashlib.sha256).hexdigest())
PY
)" || die 1 "The attachment digest could not be computed from the key file at $KEY_FILE."
}

# Print the digest fields of the WRITE_INTENT row for the approval reference.
approval_verified() {
  local journal="$1"
  python3 -I - "$journal" "$APPROVAL_REF" <<'PY'
import json
import sys

path = sys.argv[1]
reference = sys.argv[2]
try:
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if not isinstance(record, dict):
                continue
            if record.get("approval_reference") == reference and record.get("new_state") == "WRITE_INTENT":
                fields = [record.get("payload_digest"), record.get("attachment_digest"), record.get("batch_key")]
                print("\x1f".join(value if isinstance(value, str) else "" for value in fields))
                raise SystemExit(0)
except OSError:
    raise SystemExit(1)
raise SystemExit(1)
PY
}

# Load the approved digest fields for --approval or stop the write.
require_approval() {
  local journal="$ACCOUNTANT_ROOT/migration-workspace/RunJournal/run-journal.jsonl"
  local fields=""
  [[ -n "$APPROVAL_REF" ]] || die 8 "A write requires --approval <ref> for a WRITE_INTENT entry in the run journal."
  [[ -f "$journal" ]] || die 8 "The run journal is missing, so the approval reference cannot be checked."
  require_python3
  fields="$(approval_verified "$journal")" ||
    die 8 "The run journal has no WRITE_INTENT entry for the given approval reference."
  INTENT_PAYLOAD_DIGEST=""
  INTENT_ATTACHMENT_DIGEST=""
  INTENT_BATCH_KEY=""
  # WHY: The fields are joined with a unit separator so an empty field between
  # two values keeps its place when they are read back.
  IFS=$'\x1f' read -r INTENT_PAYLOAD_DIGEST INTENT_ATTACHMENT_DIGEST INTENT_BATCH_KEY <<< "$fields"
}

# Print the payload digest to stderr and exit 9 with the refusal reason.
refuse_payload() {
  printf 'payload-digest: %s\n' "$PAYLOAD_DIGEST" >&2
  die 9 "$1"
}

# Whether the write log already holds this approval reference and digest pair.
approval_consumed() {
  local log="$1"
  local reference="$2"
  local digest="$3"
  [[ -f "$log" ]] || return 1
  python3 -I - "$log" "$reference" "$digest" <<'PY'
import json
import sys

path = sys.argv[1]
reference = sys.argv[2]
digest = sys.argv[3]
try:
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if not isinstance(record, dict):
                continue
            if record.get("approval_reference") == reference and record.get("payload_digest") == digest:
                raise SystemExit(0)
except OSError:
    raise SystemExit(3)
raise SystemExit(1)
PY
}

# Refuse the write unless the payload and attachment match the approved digests.
require_payload_binding() {
  local consumed_status=0
  digest_helper "$METHOD" "$URL_PATH" "$DRY_OUTPUT"
  if [[ "$PAYLOAD_DIGEST" != "$INTENT_PAYLOAD_DIGEST" ]]; then
    refuse_payload "The writer-session payload does not match the approved payload_digest (PAYLOAD_MISMATCH)."
  fi
  ATTACHMENT_PATH="$(attachment_path)"
  if [[ -n "$ATTACHMENT_PATH" ]]; then
    attachment_digest_helper "$ATTACHMENT_PATH"
    if [[ "$ATTACHMENT_DIGEST" != "$INTENT_ATTACHMENT_DIGEST" ]]; then
      refuse_payload "The attachment bytes do not match the approved attachment_digest (PAYLOAD_MISMATCH)."
    fi
  fi
  if approval_consumed "$LOG_FILE" "$APPROVAL_REF" "$PAYLOAD_DIGEST"; then
    die 8 "The approval reference is already consumed for this payload digest. A retry needs a new WRITE_INTENT entry."
  else
    consumed_status="$?"
    [[ "$consumed_status" -eq 1 ]] ||
      die 1 "The write log at $LOG_FILE could not be read, so the approval reference cannot be checked for reuse."
  fi
}

# ───────────────────────────────────────────────────────────────
# 10. WRITE AND SESSION GATES
# ───────────────────────────────────────────────────────────────

# Gate an administration switch behind the pilot, write and approval checks.
gate_administration_use() {
  local target="${CLI_BEFORE[2]:-}"
  local pilot_id=""
  pilot_id="$(pilot_admin_id)"
  if [[ -n "$pilot_id" && "$target" == "$pilot_id" ]]; then
    return 0
  fi
  if [[ "${MONEYBIRD_GUARD_READ_ONLY:-}" == "1" ]]; then
    die 6 "Read-only lock is enabled. Switching to a non-pilot administration is blocked."
  fi
  [[ $CONFIRM_WRITE -eq 1 ]] ||
    die 3 "Administration switch blocked. Re-run with --confirm-write after reviewing the target."
  require_writer_config
  [[ $PRODUCTION -eq 1 ]] ||
    die 4 "Administration '$target' is not the pilot administration '${pilot_id:-unset}'." \
      "Pass --production only after operator approval."
  require_approval
}

# Refuse --print-body inside a marked agent session.
refuse_print_body_in_agent_session() {
  # WHY: A marker is a speed bump, not a boundary. An agent can unset a marker, so the pinned root,
  # the writer configuration and the approval journal remain the real controls.
  local marker=""
  local marker_value=""
  for marker in CLAUDECODE AI_SESSION_CHILD ACCOUNTANT_AGENT_SESSION CODEX_SANDBOX; do
    marker_value="$(printenv "$marker" 2>/dev/null || true)"
    if [[ -n "$marker_value" ]]; then
      die 2 "--print-body is refused while $marker is set. A human operator must run it outside an agent session."
    fi
  done
}

# ───────────────────────────────────────────────────────────────
# 11. RESPONSE HANDLING
# ───────────────────────────────────────────────────────────────

# Print a value-free summary of a saved response body.
summarize_body() {
  python3 -I - "$1" <<'PY'
import json
import os
import sys

path = sys.argv[1]
parts = []
try:
    parts.append("%d bytes" % os.path.getsize(path))
except OSError:
    parts.append("body size unknown")
try:
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
except OSError:
    text = ""
if not text.strip():
    parts.append("no response body")
else:
    try:
        data = json.loads(text)
    except ValueError:
        parts.append("body is not JSON")
    else:
        if isinstance(data, list):
            parts.append("records: %d" % len(data))
        elif isinstance(data, dict):
            parts.append("fields: %s" % ",".join(data.keys()))
            for value in data.values():
                if isinstance(value, list):
                    parts.append("records: %d" % len(value))
                    break
        else:
            parts.append("top-level type: %s" % type(data).__name__)
print("response: " + ", ".join(parts))
PY
}

# Run the real CLI call, save or summarize the body and remove temporary files.
run_actual() {
  local status=0
  local summary=""
  local output_dir=""
  local temporary=""
  local tmp_dir=""
  local -a args=()
  [[ ${#CLI_BEFORE[@]} -gt 0 ]] && args+=("${CLI_BEFORE[@]}")
  # WHY: The captured body is machine-read for the summary, so ask for the raw form unless it streams.
  if [[ $PRINT_BODY -eq 0 ]]; then
    args+=(--output raw)
  fi
  if [[ $OUT_SET -eq 1 ]]; then
    output_dir="${OUT_PATH%/*}"
    mkdir -p "$output_dir" || die 5 "Could not create the output folder inside migration-workspace."
    temporary="$(mktemp "$output_dir/.moneybird-guard.XXXXXX")" || die 5 "Could not create a temporary output file."
    if "$CLI" "${args[@]}" > "$temporary"; then
      mv -f "$temporary" "$OUT_PATH"
      if [[ -s "$OUT_PATH" ]]; then
        summary="$(jq -r 'if type == "array" then "items: \(length)"
          elif type == "object" then "keys: \((keys | join(",")))"
          else "top-level type: \(type)" end' "$OUT_PATH" 2>/dev/null || true)"
        [[ -n "$summary" ]] || summary="response body saved"
      else
        summary="no response body"
      fi
      printf '%s\n' "$summary"
    else
      status="$?"
      rm -f "$temporary"
    fi
  elif [[ $PRINT_BODY -eq 1 ]]; then
    "$CLI" "${args[@]}" || status="$?"
  else
    tmp_dir="$ACCOUNTANT_ROOT/migration-workspace/tmp"
    (umask 077; mkdir -p "$tmp_dir") || die 5 "Could not create the summary folder inside migration-workspace."
    [[ -L "$tmp_dir" ]] && die 5 "The summary folder resolves through a symlink."
    chmod 700 "$tmp_dir" 2>/dev/null || die 5 "Could not secure the summary folder."
    temporary="$(umask 077 && mktemp "$tmp_dir/.moneybird-guard.XXXXXX")" ||
      die 5 "Could not create a temporary summary file."
    chmod 600 "$temporary" 2>/dev/null ||
      die 5 "Could not secure the temporary summary file."
    "$CLI" "${args[@]}" > "$temporary" || status="$?"
    if [[ $status -eq 0 ]]; then
      require_python3
      summary="$(summarize_body "$temporary")" || die 1 "The response body could not be summarised."
      printf '%s\n' "$summary"
    fi
    rm -f "$temporary"
  fi
  return "$status"
}

# ───────────────────────────────────────────────────────────────
# 12. LOGIN DISPATCH
# ───────────────────────────────────────────────────────────────

if [[ "${CLI_BEFORE[0]:-}" == "login-from-env" ]]; then
  [[ $OUT_SET -eq 0 ]] || die 2 "--out does not apply to login-from-env."
  [[ $PRINT_BODY -eq 0 ]] || die 2 "--print-body does not apply to login-from-env."
  [[ ${#CLI_BEFORE[@]} -eq 1 ]] || die 2 "Use login-from-env with no CLI arguments."
  TOKEN_FILE="$ACCOUNTANT_ROOT/.env"
  if [[ $WRITER_LOGIN -eq 1 ]]; then
    TOKEN_FILE="$ACCOUNTANT_ROOT/.env.writer"
    export MONEYBIRD_CONFIG_DIR="$WRITER_CONFIG_DIR"
  fi
  if ! TOKEN="$(read_env_value "$TOKEN_FILE" MONEYBIRD_API_TOKEN)" || [[ -z "$TOKEN" ]]; then
    die 1 "MONEYBIRD_API_TOKEN is unset in the selected credential file."
  fi
  if printf '%s\n' "$TOKEN" | "$CLI" login >/dev/null 2>&1; then
    unset TOKEN
    printf 'Moneybird login completed. CLI output was suppressed.\n'
    exit 0
  else
    login_status="$?"
    unset TOKEN
    printf 'Moneybird login failed with exit status %s. Check the selected credential file and CLI setup.\n' \
      "$login_status" >&2
    exit "$login_status"
  fi
fi

# ───────────────────────────────────────────────────────────────
# 13. MAIN FLOW
# ───────────────────────────────────────────────────────────────

[[ $WRITER_LOGIN -eq 0 ]] || die 2 "--writer is valid only with login-from-env."
[[ ${#CLI_BEFORE[@]} -gt 0 ]] || { usage >&2; exit 2; }
[[ $PRINT_BODY -eq 0 || $OUT_SET -eq 0 ]] || die 2 "--print-body and --out cannot be combined."
# WHY: The refusal is an argument check, so it runs before the dry-run and every gate.
[[ $PRINT_BODY -eq 0 ]] || refuse_print_body_in_agent_session
if is_passthrough; then
  [[ $OUT_SET -eq 0 ]] || die 2 "--out does not apply to passthrough commands."
  if [[ "${CLI_BEFORE[0]:-}" == "administration" && "${CLI_BEFORE[1]:-}" == "use" ]]; then
    gate_administration_use
  fi
  run_passthrough
fi
if [[ $OUT_SET -eq 1 ]]; then
  if ! validate_out_path; then
    die 5 "--out must resolve to a file inside migration-workspace, outside its .secrets," \
      "RunJournal and logs folders, and cannot cross a symlink."
  fi
fi

DRY_OUTPUT=""
run_dry
if ! parse_dry_line; then
  die 2 "The CLI dry-run did not begin with a METHOD URL line."
fi
DRY_LINE="${DRY_OUTPUT%%$'\n'*}"

if [[ "$METHOD" == "GET" ]] || is_sync_fetch; then
  if is_list_action && ! has_period_filter; then
    printf 'Warning: Moneybird lists default to period:this_year. '\
'Older years will be missing unless --filter includes period:.\n' >&2
  fi
  run_actual || exit "$?"
  exit 0
fi

if [[ "${MONEYBIRD_GUARD_READ_ONLY:-}" == "1" ]]; then
  printf '%s\n' "$DRY_LINE" >&2
  die 6 "Read-only lock is enabled. Non-GET $METHOD calls are blocked."
fi

if [[ $CONFIRM_WRITE -ne 1 ]]; then
  printf '%s\n' "$DRY_LINE" >&2
  digest_helper "$METHOD" "$URL_PATH" "$DRY_OUTPUT"
  printf 'payload-digest: %s\n' "$PAYLOAD_DIGEST" >&2
  ATTACHMENT_PATH="$(attachment_path)"
  if [[ -n "$ATTACHMENT_PATH" ]]; then
    attachment_digest_helper "$ATTACHMENT_PATH"
    printf 'attachment-digest: %s\n' "$ATTACHMENT_DIGEST" >&2
  fi
  die 3 "Write blocked. Re-run with --confirm-write after reviewing the dry-run."
fi

require_writer_config
export MONEYBIRD_CONFIG_DIR="$WRITER_CONFIG_DIR"
run_dry
if ! parse_dry_line; then
  die 2 "The writer configuration dry-run did not begin with a METHOD URL line."
fi

PILOT_ADMIN_ID="$(pilot_admin_id)"
if [[ -z "$PILOT_ADMIN_ID" ]]; then
  if [[ $PRODUCTION -ne 1 ]]; then
    die 4 "Pilot administration is unset and target '$ADMIN_ID' is treated as production." \
      "Pass --production only after operator approval."
  fi
elif [[ "$ADMIN_ID" != "$PILOT_ADMIN_ID" && $PRODUCTION -ne 1 ]]; then
  die 4 "Pilot administration '$PILOT_ADMIN_ID' differs from target '$ADMIN_ID'." \
    "Pass --production only after operator approval."
fi

LOG_DIR="$ACCOUNTANT_ROOT/migration-workspace/logs"
LOG_FILE="$LOG_DIR/moneybird-writes.jsonl"
require_approval
require_payload_binding

if ! command -v jq >/dev/null 2>&1; then
  die 1 "jq is required to append the write log."
fi
WRITE_STATUS=0
run_actual || WRITE_STATUS="$?"
if [[ $WRITE_STATUS -eq 0 ]]; then
  printf 'Moneybird write succeeded: %s %s\n' "$METHOD" "$URL_PATH" >&2
  printf 'An immediate GET may return cached data. The write response status is the proof.\n' >&2
  if [[ "$METHOD" == "DELETE" ]]; then
    printf 'A DELETE response of 204 can mean nothing was deleted. Confirm with a separate read.\n' >&2
  fi
fi
LOG_TIMESTAMP="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
LOG_RECORD="$(jq -cn \
  --arg timestamp "$LOG_TIMESTAMP" \
  --arg method "$METHOD" \
  --arg path "$URL_PATH" \
  --arg administration_id "$ADMIN_ID" \
  --argjson exit_status "$WRITE_STATUS" \
  --arg approval_reference "$APPROVAL_REF" \
  --arg batch_key "$INTENT_BATCH_KEY" \
  --arg payload_digest "$PAYLOAD_DIGEST" \
  '{timestamp:$timestamp,method:$method,path:$path,
    administration_id:$administration_id,exit_status:$exit_status,
    approval_reference:$approval_reference,batch_key:$batch_key,
    payload_digest:$payload_digest}')"
if (umask 077; mkdir -p "$LOG_DIR" && printf '%s\n' "$LOG_RECORD" >> "$LOG_FILE"); then
  chmod 600 "$LOG_FILE" 2>/dev/null || true
else
  if [[ $WRITE_STATUS -eq 0 ]]; then
    printf 'Write succeeded, but the local write log could not be appended.\n' >&2
  else
    printf 'The failed write attempt could not be appended to the local write log.\n' >&2
  fi
fi
exit "$WRITE_STATUS"
