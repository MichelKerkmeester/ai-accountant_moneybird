{
  "version": "1.0.0.0",
  "hub": "moneybird-accountant",
  "extensions": {
    "repo-root-hub": {
      "description": "The hub is the Moneybird Accountant repository root. repoPaths lists the top-level entries that belong to the repository rather than the skill: the spec packets, the repository scripts, the private data folders and the repository files beside them. The skilled checkers skip them, and the hub id is the folder name Moneybird Accountant in kebab case.",
      "repoPaths": [
        "specs",
        "scripts",
        "personal database",
        "migration-workspace",
        "AGENTS.md",
        "LICENSE"
      ]
    }
  },
  "modes": [
    {
      "workflowMode": "accountant",
      "packet": "sk-moneybird-accountant",
      "packetSkillName": "sk-moneybird-accountant",
      "packetKind": "workflow",
      "router": "sk-moneybird-accountant/ROUTER.md",
      "default": true
    },
    {
      "workflowMode": "cli-moneybird",
      "packet": "cli-moneybird",
      "packetSkillName": "cli-moneybird",
      "packetKind": "tool",
      "router": "cli-moneybird/ROUTER.md",
      "default": false
    },
    {
      "workflowMode": "cli-jortt",
      "packet": "cli-jortt",
      "packetSkillName": "cli-jortt",
      "packetKind": "tool",
      "router": "cli-jortt/ROUTER.md",
      "default": false
    }
  ]
}
