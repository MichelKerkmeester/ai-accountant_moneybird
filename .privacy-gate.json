    ".githooks/pre-merge-commit",
    ".githooks/pre-push",
    ".githooks/commit-msg",
    ".githooks/prepare-commit-msg",
    ".githooks/post-commit",
    ".githooks/post-merge",
    ".githooks/post-rewrite",
    "sk-moneybird-accountant/assets/migration/workspace-folders.txt"
  ],
  "blocked_paths": [
    "personal database",
    "migration-workspace/",
    "specs/",
    ".env",
    ".privacy-denylist"
  ],
  "blocked_names_anywhere": [
    "personal database",
    "migration-workspace",
    ".env",
    ".privacy-denylist"
  ],
  "blocked_path_exceptions": [
    {
      "prefix": "specs/000-migration-template/",
