    }
  ],
  "max_file_bytes": 524288,
  "gate_change_baseline": "7bd09e540406d93f4e0964db2c7247436e088fab",
  "amount_allowed_files": [
    "sk-moneybird-accountant/references/zzp-tax-and-vat.md",
    "sk-moneybird-accountant/references/moneybird-bookkeeping.md",
    "sk-moneybird-accountant/references/migration/overview-and-setup.md",
    "sk-moneybird-accountant/references/migration/phases-10-to-16.md",
    "scripts/privacy-gate.py",
    "scripts/privacy-gate-test.sh"
  ],
  "secret_allowed_files": [
    "cli-moneybird/cli/moneybird-cli/tests/run-tests.sh",
    "cli-jortt/cli/jortt-cli/tests/run-tests.sh",
    "scripts/privacy-gate.py",
    "scripts/privacy-gate-test.sh"
  ],
  "email_allowed_domains": [
    "example.com",
    "example.org",
    "example.net",
    "users.noreply.github.com"
  ],
  "gate_files": [
    ".privacy-gate.json",
    "scripts/privacy-gate.py",
    "scripts/privacy-gate-test.sh",
    "scripts/install-hooks.sh",
    ".github/workflows/privacy-gate.yml",
    ".gitignore",
    ".github/dependabot.yml",
    "sk-moneybird-accountant/scripts/generate-plan-kit.py",
    "sk-moneybird-accountant/scripts/plan-kit-test.sh",
    "sk-moneybird-accountant/scripts/init-workspace.sh"
  ],
  "gate_directories": [
    ".githooks/",
    ".github/workflows/"
  ]
}
