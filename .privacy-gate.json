{
  "allowed_extensions": [
    "md",
    "json",
    "sh",
    "py",
    "yml",
    "tmpl"
  ],
  "allowed_files": [
    "LICENSE",
    ".gitignore",
    ".env.example",
    ".privacy-gate.json",
    ".privacy-denylist.example",
    "cli-jortt/cli/jortt-cli/jortt-cli",
    "cli-moneybird/cli/moneybird-cli/moneybird-guard",
    "cli-moneybird/cli/moneybird-cli/tests/stub-moneybird-cli",
