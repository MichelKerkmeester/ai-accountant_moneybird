        "expenses:read": "Read expenses.",
        "expenses:write": "Create or change expenses."
      }
    }
  },
  "paths": {
    "/customers": {
      "get": {
        "operationId": "list-customers",
        "tags": ["customers"],
        "summary": "List customers",
        "security": [{"OAuth2": ["customers:read"]}],
        "parameters": [
          {"name": "page", "in": "query", "required": false, "type": "integer"},
          {"name": "per_page", "in": "query", "required": false, "type": "integer"}
        ],
        "responses": {"200": {"description": "A paginated customer list."}}
      }
    },
    "/v1/customers": {
      "get": {
        "operationId": "list-customers",
        "tags": ["customers"],
        "summary": "List customers",
        "security": [{"OAuth2": ["customers:read"]}],
        "parameters": [
          {"name": "page", "in": "query", "required": false, "type": "integer"},
          {"name": "per_page", "in": "query", "required": false, "type": "integer"}
        ],
        "responses": {"200": {"description": "A paginated customer list."}}
