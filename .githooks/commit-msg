#!/usr/bin/env bash
# Scan the commit message before the commit exists. A staged gate file change
# needs the trailer line in the message and the Operator's approval variable,
# then the global commit-msg hook is forwarded to so its checks still run.
set -u

message="${1:-}"
if [ -n "$message" ]; then
  if ! python3 -I scripts/privacy-gate.py --message "$message"; then
    printf 'privacy-gate: commit message blocked, run the gate again with:\n' >&2
    printf '  python3 -I scripts/privacy-gate.py --message %s\n' "$message" >&2
    printf 'privacy-gate: a gate file change needs the trailer line %s\n' \
      'Privacy-Gate-Change: approved' >&2
    exit 1
  fi
fi

# This repo points core.hooksPath at .githooks for the privacy gate, which hides
# the global hooks. Forward to the global commit-msg so its checks still run.
global="$(git config --global core.hooksPath 2>/dev/null || true)"
case "$global" in
  "~") global="$HOME" ;;
  "~/"*) global="$HOME${global#\~}" ;;
esac
[ -n "$global" ] || exit 0
self_dir="$(cd "$(dirname "$0")" && pwd)"
hook_dir="$(cd "$global" 2>/dev/null && pwd)" || exit 0
if [ "$hook_dir" != "$self_dir" ] && [ -x "$hook_dir/commit-msg" ]; then
  exec "$hook_dir/commit-msg" "$@"
fi
exit 0
