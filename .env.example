# Copy to .env and fill in. .env is gitignored; never commit real values.

# Jortt REST API, client credentials grant (app.jortt.nl > API keys).
# Token endpoint: https://app.jortt.nl/oauth-provider/oauth/token
JORTT_CLIENT_ID=
JORTT_CLIENT_SECRET=
# Read-only scopes for the migration. Never add a :write scope here.
JORTT_SCOPES="organizations:read customers:read invoices:read expenses:read receipts:read financing:read reconciling:read reports:read"

# Moneybird REST API v2, personal API token (Settings > External applications and MCP).
# This token can write. From the pilot (Phase 7) onward, move it to .env.writer,
# which only the Migration Writer session loads.
# Requests go to https://moneybird.com/api/v2/{MONEYBIRD_ADMINISTRATION_ID}/...
MONEYBIRD_API_TOKEN=
# Leave empty to read it from GET /api/v2/administrations during the first check.
MONEYBIRD_ADMINISTRATION_ID=
# Throwaway administration for the pilot (Phase 7), kept apart from the production one.
MONEYBIRD_PILOT_ADMINISTRATION_ID=
