# Personal financial data, linked from outside the repo
personal database

# Migration working data: registers, mappings, exceptions, reports, snapshots
migration-workspace/

# Local credentials
.env
.env.*
!.env.example

.DS_Store

# Spec Kit packets stay local, except the public migration template packet
!/specs/
/specs/*
!/specs/000-migration-template/

# Local list of private terms checked by the privacy gate, never committed
/.privacy-denylist

# Python bytecode caches
__pycache__/
*.pyc
